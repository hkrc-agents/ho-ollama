{
  "module": {
    "name": "entry", "type": "entry", "mainElement": "EntryAbility", "deviceTypes": ["2in1"],
    "deliveryWithInstall": true, "installationFree": false, "pages": "$profile:main_pages",
    "hnpPackages": [{"package": "ollama.hnp", "type": "public"}],
    "requestPermissions": [
      {"name": "ohos.permission.INTERNET"},
      {"name": "ohos.permission.KEEP_BACKGROUND_RUNNING"},
      {"name": "ohos.permission.PREPARE_APP_TERMINATE"},
      {"name": "ohos.permission.FILE_ACCESS_PERSIST"}
    ],
    "abilities": [
      {
        "name": "EntryAbility", "srcEntry": "./ets/entryability/EntryAbility.ets",
        "launchType": "singleton", "exported": true,
        "skills": [{"entities": ["entity.system.home"], "actions": ["ohos.want.action.home"]}],
        "icon": "$media:ollama_icon", "label": "$string:app_name",
        "startWindowIcon": "$media:ollama_icon", "startWindowBackground": "$color:background"
      },
      {
        "name": "MainAbility", "srcEntry": "./ets/entryability/MainAbility.ets",
        "launchType": "singleton", "backgroundModes": ["taskKeeping"], "exported": false,
        "icon": "$media:ollama_icon", "label": "$string:app_name",
        "startWindowIcon": "$media:ollama_icon", "startWindowBackground": "$color:background"
      }
    ],
    "extensionAbilities": [
      {"name": "TrayViewAbility", "srcEntry": "./ets/entryability/TrayViewAbility.ets", "type": "statusBarView", "exported": false}
    ]
  }
}
