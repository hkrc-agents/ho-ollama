diff --git a/app/ui/app/src/lib/platform.ts b/app/ui/app/src/lib/platform.ts
--- a/app/ui/app/src/lib/platform.ts
+++ b/app/ui/app/src/lib/platform.ts
@@ -12,3 +12,14 @@ export function isWindowsPlatform(): boolean {
     navigator.platform.toLowerCase().includes("win")
   );
 }
+
+// Desktop integrations require macOS capabilities, not merely "not Windows".
+export function isMacOSPlatform(): boolean {
+  if (typeof window !== "undefined" && window.OLLAMA_PLATFORM) {
+    return window.OLLAMA_PLATFORM === "darwin";
+  }
+  return (
+    typeof navigator !== "undefined" &&
+    navigator.platform.toLowerCase().includes("mac")
+  );
+}
