# Enable upstream tests on the already-patched Ollama runner source without
# modifying either upstream CMakeLists. Mirror the runner's compatibility links.
if(NOT DEFINED PICO_OLLAMA_SOURCE)
    message(FATAL_ERROR "PICO_OLLAMA_SOURCE is required")
endif()
function(pico_link_runner_compat)
    if(CMAKE_SYSTEM_NAME STREQUAL "OHOS" AND LLAMA_SUBPROCESS)
        # API23 lacks posix_spawn_file_actions_addchdir_np. Use the vendor's
        # existing async-signal-safe fork/exec + exec-error-pipe fallback.
        target_compile_definitions(sheredom INTERFACE SUBPROCESS_SPAWN_VIA_FORK=1)
    endif()
    if(PICO_OHOS_SYSTEM_TLS)
        if(NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR NOT TARGET llama-common)
            message(FATAL_ERROR "System TLS adapter requires the OHOS common target")
        endif()
        target_compile_definitions(llama-common PUBLIC PICO_OHOS_SYSTEM_TLS=1)
        target_link_libraries(llama-common PUBLIC net_ssl)
    endif()
    # Release test executables must retain their upstream assert() checks.
    # Apply only to tests, not to the production libraries' optimization flags.
    if(LLAMA_BUILD_TESTS)
        get_property(pico_test_targets DIRECTORY "${PROJECT_SOURCE_DIR}/tests" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(pico_test_target IN LISTS pico_test_targets)
            get_target_property(pico_test_type ${pico_test_target} TYPE)
            if(pico_test_type STREQUAL "EXECUTABLE")
                target_compile_options(${pico_test_target} PRIVATE -UNDEBUG)
            endif()
        endforeach()
    endif()
    if(PICO_OHOS_TMPFILE_COMPAT)
        if(NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS")
            message(FATAL_ERROR "tmpfile compatibility requires OHOS")
        endif()
        add_library(pico-ohos-tmpfile STATIC "${PICO_PLATFORM_ADAPTER_DIR}/ohos_tmpfile_compat.c")
        target_link_libraries(llama PUBLIC pico-ohos-tmpfile)
        target_link_options(llama INTERFACE "LINKER:--wrap=tmpfile" "LINKER:--wrap=tmpfile64")
    endif()
    set(compat "${PICO_OLLAMA_SOURCE}/llama/compat")
    file(GLOB sources "${compat}/*.cpp" "${compat}/models/*.cpp")
    target_sources(llama PRIVATE ${sources})
    target_include_directories(llama PRIVATE "${compat}" "${compat}/models" "${PROJECT_SOURCE_DIR}/src")
    if(TARGET mtmd)
        target_include_directories(mtmd PRIVATE "${compat}")
    endif()
    if(TARGET server-context)
        target_sources(server-context PRIVATE "${PICO_OLLAMA_SOURCE}/llama/clef/clef.cpp")
        target_include_directories(server-context PRIVATE "${PICO_OLLAMA_SOURCE}/llama/clef")
    endif()
endfunction()
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
    cmake_language(DEFER CALL pico_link_runner_compat)
endif()
